{
  "manifest_version": 3,
  "name": "WeebCentral Kindle Downloader",
  "version": "1.0.0",
  "description": "Download WeebCentral manga chapters in CBZ/ZIP for KOReader and transfer to Kindle via SSH/SCP",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "WeebCentral Manga Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "https://weebcentral.com/*",
    "https://*.weebcentral.com/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://weebcentral.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}